{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "redirects": [
    {
      "source": "/works/:slug(auto-repair-shop|ai-influencer|sns-ad-video|zukin-note|auto-accounting|welfare-matching|ec-site|internal-rag|grant-recommender|video-pipeline|order-management)",
      "destination": "/works/:slug.html",
      "permanent": true
    },
    {
      "source": "/services/:slug(automation|app-development|ai-influencer|ai-agent|ai-video|video-editing|training-video|manual-to-video)",
      "destination": "/services/:slug.html",
      "permanent": true
    },
    {
      "source": "/works",
      "destination": "/works.html",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/industries.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/examples",
      "destination": "/industries.html",
      "permanent": true
    },
    {
      "source": "/guides/:slug(ai-agent-guide|ai-video-guide|manual-video-guide)",
      "destination": "/guides/:slug.html",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/guides.html",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/scripts/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/content/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/README.md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
